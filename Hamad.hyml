<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Birthday Surprise</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Tahoma,sans-serif;
}

body{
    overflow:hidden;
    background:#000;
}

/* = MATRIX = */

#matrixPage{
    position:fixed;
    inset:0;
    background:#000;
    display:flex;
    justify-content:center;
    align-items:flex-end;
    flex-direction:column;
}

canvas{
    position:absolute;
    inset:0;
}

.loader{
    width:80%;
    height:20px;
    border:2px solid #00ff99;
    margin:40px auto;
    border-radius:30px;
    overflow:hidden;
    z-index:2;
}

.bar{
    height:100%;
    width:0%;
    background:#00ff99;
    animation:load 8s linear forwards;
}

@keyframes load{
    from{width:0%;}
    to{width:100%;}
}

/* = BIRTHDAY = */

#birthdayPage{
    display:none;
    position:fixed;
    inset:0;
    overflow:hidden;
    background:linear-gradient(135deg,#ffd6e8,#d8f5ff,#fff5b7);
    text-align:center;
}

.content{
    position:relative;
    z-index:10;
    max-width:900px;
    margin:auto;
    padding-top:60px;
}

h1{
    font-size:50px;
    color:#ff1493;
    margin-bottom:25px;
}

.message{
    background:rgba(255,255,255,.85);
    padding:25px;
    border-radius:20px;
    font-size:22px;
    color:#444;
    line-height:2;
    margin:20px;
}

button{
    margin-top:30px;
    padding:15px 40px;
    font-size:20px;
    border:none;
    border-radius:40px;
    cursor:pointer;
    background:#ff1493;
    color:white;
    transition:.3s;
}

button:hover{
    transform:scale(1.05);
    background:#ff0088;
}

/* = HEARTS = */

.heart{
    position:absolute;
    color:red;
    animation:floatUp linear infinite;
    opacity:.8;
}

@keyframes floatUp{
    from{
        transform:translateY(100vh);
        opacity:1;
    }
    to{
        transform:translateY(-120vh);
        opacity:0;
    }
}

/* = BALLOONS = */

.balloon{
    position:absolute;
    width:55px;
    height:70px;
    border-radius:50%;
    animation:balloon linear infinite;
}

.balloon::after{
    content:"";
    position:absolute;
    width:2px;
    height:70px;
    background:#555;
    left:50%;
    top:70px;
}

@keyframes balloon{
    from{
        transform:translateY(120vh);
    }
    to{
        transform:translateY(-150vh);
    }
}

</style>

</head>
<body>

<!-- MATRIX -->

<div id="matrixPage">
<canvas id="matrix"></canvas>

<div class="loader">
<div class="bar"></div>
</div>
</div>

<!-- BIRTHDAY -->

<div id="birthdayPage">

<div class="content">

<h1>🎉 عيد ميلاد سعيد 🎂</h1>

<div class="message">

:<br><br>
أحبك…

وأرى أن كل ما يُقال في المحبة أقل من أن يفيكِ حقكِ، وفي يوم مولدكِ

أجدني أرددها كما لو أنني أقولها للمرة الأولى، 
وأوقن بها كما لو أنني عرفتها منذ الأزل.

فأنتِ حبيبتي اليوم، 
وحبيبتي غدًا، 
وحبيبتي بعد أعوام لا يُحصيها العمر.

وأنتِ الأمنية التي لم أتجاوزها، 
والوجه الذي كلما ازدحم النسيان في قلبي بقي وحده حاضرًا، 
فأذكره وأبتسم.

كل عام وأنتِ حبيبتي في كُل الأعوام.

H♥Y
‏</div>

<button onclick="window.open("https://on.soundcloud.com/m8JHw7tSvmYePgvvYC","_blank");
">
🎵 فتح SoundCloud
</button>

</div>

</div>

<script>

/* = MATRIX = */

const canvas=document.getElementById("matrix");
const ctx=canvas.getContext("2d");

canvas.width=innerWidth;
canvas.height=innerHeight;

const letters="アァカサタナハマヤャラワン0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
const chars=letters.split("");

const size=18;
const columns=canvas.width/size;
const drops=[];

for(let i=0;i<columns;i) drops[i]=1;

function draw(){

ctx.fillStyle="rgba(0,0,0,.05)";
ctx.fillRect(0,0,canvas.width,canvas.height);

ctx.fillStyle="#00ff66";
ctx.font=size+"px monospace";

for(let i=0;i<drops.length;i){

const text=chars[Math.floor(Math.random()*chars.length)];

ctx.fillText(text,i*size,drops[i]*size);

if(drops[i]*size>canvas.height && Math.random()>0.975)
drops[i]=0;

drops[i];

}

}

setInterval(draw,35);

/* = SWITCH = */

setTimeout(()=>{

document.getElementById("matrixPage").style.display="none";
document.getElementById("birthdayPage").style.display="block";

createHearts();
createBalloons();

},8000);

/* = HEARTS = */

function createHearts(){

for(let i=0;i<35;i){

const h=document.createElement("div");

h.className="heart";
h.innerHTML="❤";

h.style.left=Math.random()*100+"%";
h.style.fontSize=(15+Math.random()*35)+"px";
h.style.animationDuration=(5+Math.random()*8)+"s";
h.style.animationDelay=Math.random()*5+"s";

document.getElementById("birthdayPage").appendChild(h);

}

}

/* = BALLOONS = */

const colors=[
"#ff4d6d",
"#4dabf7",
"#69db7c",
"#ffd43b",
"#cc5de8",
"#ff922b"
];

function createBalloons(){

for(let i=0;i<18;i++){

const b=document.createElement("div");

b.className="balloon";

b.style.left=Math.random()*100+"%";
b.style.background=colors[Math.floor(Math.random()*colors.length)];

b.style.animationDuration=(10+Math.random()*10)+"s";
b.style.animationDelay=Math.random()*6+"s";

document.getElementById("birthdayPage").appendChild(b);

}

}

window.onresize=()=>{

canvas.width=innerWidth;
canvas.height=innerHeight;

};

</script>


</body>
</html>
